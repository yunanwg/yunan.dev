// Static assets only: no Worker code runs. Deployed by .github/workflows/deploy.yml.
{
  "name": "yunan-dev",
  "compatibility_date": "2026-10-01",
  // One public address: yunan.dev. No workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Wrangler creates the DNS record and certificate for the custom domain on deploy.
  "routes": [{ "pattern": "yunan.dev", "custom_domain": true }]
}
